{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kc-activity-finder/source-graph.schema.json",
  "title": "KC activity source graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "last_reviewed",
    "seed_material",
    "nodes",
    "edges",
    "frontier_rules",
    "supplement_policy"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "last_reviewed": {"type": "string", "format": "date"},
    "seed_material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "preservation", "sha256"],
      "properties": {
        "path": {"const": "data/primary-sources.txt"},
        "preservation": {"const": "verbatim"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "canonical_url",
          "source_class",
          "roles",
          "status",
          "coverage",
          "provenance",
          "verification"
        ]
      }
    },
    "edges": {"type": "array"},
    "frontier_rules": {"type": "array", "minItems": 1},
    "supplement_policy": {
      "type": "object",
      "required": [
        "allowed_after_stage",
        "label",
        "must_resolve_to_first_party_before_recommendation",
        "may_become_graph_node_only_with_observed_relation",
        "never_promote_to_provided_seed"
      ]
    }
  }
}
