{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/kc-activity-finder/candidate.schema.json",
  "title": "KC activity candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "title",
    "mode",
    "event_type",
    "timing",
    "place",
    "discovery",
    "verification",
    "availability",
    "cost",
    "dedupe_key",
    "ranking",
    "adversarial_review"
  ],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "mode": {"enum": ["weekend-current", "signup-horizon"]},
    "event_type": {
      "enum": [
        "drop-in",
        "performance",
        "race",
        "festival",
        "class",
        "timed-entry",
        "ticketed-event",
        "outdoor",
        "other"
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "timezone"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": ["string", "null"], "format": "date-time"},
        "timezone": {"const": "America/Chicago"}
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["venue", "city", "region"],
      "properties": {
        "venue": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1},
        "state": {"type": ["string", "null"]},
        "region": {
          "enum": ["Kansas City metro", "Lawrence", "Columbia", "Bentonville", "surrounding areas"]
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "discovery_url", "captured_at"],
      "properties": {
        "channel": {"enum": ["source-graph", "broader-web-search"]},
        "source_node_id": {"type": ["string", "null"]},
        "discovery_url": {"type": "string", "format": "uri"},
        "captured_at": {"type": "string", "format": "date-time"}
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_type", "url", "observed_at", "supports"],
        "properties": {
          "evidence_type": {
            "enum": [
              "first-party-event",
              "first-party-organizer",
              "first-party-venue",
              "first-party-registration",
              "editorial",
              "web-search"
            ]
          },
          "url": {"type": "string", "format": "uri"},
          "observed_at": {"type": "string", "format": "date-time"},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "action_url": {"type": ["string", "null"], "format": "uri"},
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_at", "deadline"],
      "properties": {
        "status": {"enum": ["available", "limited", "waitlist", "unknown", "sold-out", "cancelled"]},
        "checked_at": {"type": "string", "format": "date-time"},
        "deadline": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "min", "max", "fees_unknown"],
      "properties": {
        "currency": {"const": "USD"},
        "min": {"type": ["number", "null"], "minimum": 0},
        "max": {"type": ["number", "null"], "minimum": 0},
        "fees_unknown": {"type": "boolean"}
      }
    },
    "restrictions": {"type": "array", "items": {"type": "string"}},
    "weather_sensitive": {"type": "boolean"},
    "dedupe_key": {"type": "string", "minLength": 1},
    "ranking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "personal_fit",
        "timing_actionability",
        "distinctiveness",
        "evidence_confidence",
        "logistics",
        "value",
        "geographic_intent",
        "penalties",
        "total"
      ],
      "properties": {
        "personal_fit": {"type": "integer", "minimum": 0, "maximum": 30},
        "timing_actionability": {"type": "integer", "minimum": 0, "maximum": 15},
        "distinctiveness": {"type": "integer", "minimum": 0, "maximum": 15},
        "evidence_confidence": {"type": "integer", "minimum": 0, "maximum": 15},
        "logistics": {"type": "integer", "minimum": 0, "maximum": 10},
        "value": {"type": "integer", "minimum": 0, "maximum": 10},
        "geographic_intent": {"type": "integer", "minimum": 0, "maximum": 5},
        "penalties": {"type": "integer", "maximum": 0},
        "total": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "adversarial_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["overall", "checks"],
      "properties": {
        "overall": {"enum": ["pass", "hold", "fail"]},
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "status", "notes"],
            "properties": {
              "id": {"type": "string"},
              "status": {"enum": ["pass", "uncertain", "fail"]},
              "notes": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
